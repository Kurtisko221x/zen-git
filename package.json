{
  "name": "zen-git",
  "version": "0.1.0",
  "description": "Git, but make it aesthetic. Gradients, spinners, ASCII art and good vibes after every commit.",
  "type": "module",
  "bin": {
    "zen": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
