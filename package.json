    "chalk": "^6.0.1",
    "gradient-string": "^3.0.0",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
